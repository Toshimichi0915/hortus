{
  "name": "hortus",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/exec",
        {
          "prepareCmd": "pnpm -r exec npm pkg set version=${nextRelease.version}",
          "publishCmd": "pnpm -r exec sh -c 'pnpm pack && npm publish *.tgz'"
        }
      ],
      "@semantic-release/github"
    ]
  },
  "scripts": {
    "release": "semantic-release",
    "build": "tsc -b packages/cli",
    "dev": "tsc -b packages/cli && node packages/cli/dist/index.js",
    "lint": "biome lint",
    "format": "biome format --write",
    "test": "tsc -b packages/cli && node --test 'packages/*/dist/**/*.test.js'"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^26.6.5",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2"
  }
}
